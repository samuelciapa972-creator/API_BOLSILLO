{
  "info": {
    "name": "API Bolsillo — Lab 5 Parte 1 (Integridad referencial + API Keys)",
    "description": "Colección de evidencias para el checkpoint del Bloque 1 (integridad referencial), Bloque 2 (pruebas manuales de lógica de negocio) y Bloque 3 (API Key). Ejecuta las carpetas EN ORDEN. Antes de la carpeta 'Bloque 2', reinicia el servidor (Ctrl+C y `npm run dev`) para volver a la data semilla, porque la carpeta 1 modifica el saldo del bolsillo 1.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "apikey",
    "apikey": [
      { "key": "key", "value": "X-API-Key", "type": "string" },
      { "key": "value", "value": "{{apiKey}}", "type": "string" },
      { "key": "in", "value": "header", "type": "string" }
    ]
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000", "type": "string" }
  ],
  "item": [
    {
      "name": "Bloque 1 - Integridad referencial",
      "description": "Usa la data semilla original (usuario 1 con cuenta 1; bolsillo 1 con saldo 80000). Ejecuta en orden, de arriba hacia abajo.",
      "item": [
        {
          "name": "1.1 DELETE usuario con cuenta -> 409",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/usuarios/1", "host": ["{{baseUrl}}"], "path": ["api", "usuarios", "1"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 409', function () { pm.response.to.have.status(409); });"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "1.2 POST usuario nuevo (sin cuentas) -> 201",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Usuario Prueba Integridad\",\n  \"documento\": \"3216549870\",\n  \"email\": \"prueba.integridad@example.com\",\n  \"telefono\": \"3111111111\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/api/usuarios", "host": ["{{baseUrl}}"], "path": ["api", "usuarios"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 201', function () { pm.response.to.have.status(201); });",
                  "const data = pm.response.json();",
                  "pm.environment.set('usuarioNuevoId', data.usuario.id);"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "1.3 DELETE usuario nuevo (sin relaciones) -> 200",
