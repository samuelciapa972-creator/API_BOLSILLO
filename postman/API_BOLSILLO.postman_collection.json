    {
      "name": "Bloque 3 - API Key",
      "description": "Antes de correr esta carpeta, abre el entorno 'API Bolsillo - Local' y pega en la variable 'apiKey' el valor real que está en tu archivo .env.",
      "item": [
        {
          "name": "3.1 GET usuarios sin X-API-Key -> 401",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/usuarios", "host": ["{{baseUrl}}"], "path": ["api", "usuarios"] }
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Status 401', function () { pm.response.to.have.status(401); });"], "type": "text/javascript" } }]
        },
        {
          "name": "3.2 GET usuarios con X-API-Key incorrecta -> 401",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [{ "key": "X-API-Key", "value": "{{apiKeyIncorrecta}}" }],
            "url": { "raw": "{{baseUrl}}/api/usuarios", "host": ["{{baseUrl}}"], "path": ["api", "usuarios"] }
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Status 401', function () { pm.response.to.have.status(401); });"], "type": "text/javascript" } }]
        },
        {
          "name": "3.3 GET usuarios con X-API-Key correcta -> 200",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/usuarios", "host": ["{{baseUrl}}"], "path": ["api", "usuarios"] }
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Status 200', function () { pm.response.to.have.status(200); });"], "type": "text/javascript" } }]
        },
        {
          "name": "3.4 GET usuarios con la key en query string (sin header) -> 401",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/usuarios?apiKey={{apiKey}}", "host": ["{{baseUrl}}"], "path": ["api", "usuarios"], "query": [{ "key": "apiKey", "value": "{{apiKey}}" }] }
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Status 401', function () { pm.response.to.have.status(401); });"], "type": "text/javascript" } }]
