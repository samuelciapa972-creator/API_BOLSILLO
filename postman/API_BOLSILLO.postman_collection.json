    {
      "name": "Bloque 2 - Pruebas manuales de logica de negocio",
      "description": "REINICIA EL SERVIDOR ANTES DE ESTA CARPETA (Ctrl+C y npm run dev) para volver a la data semilla original.",
      "item": [
        {
          "name": "2.1 POST bolsillo con Mass Assignment (saldo:999999) -> 201, saldo real 0",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"cuentaId\": 1,\n  \"nombre\": \"Bolsillo Mass Assignment\",\n  \"saldo\": 999999\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/api/bolsillos", "host": ["{{baseUrl}}"], "path": ["api", "bolsillos"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 201', function () { pm.response.to.have.status(201); });",
                  "const data = pm.response.json();",
                  "pm.test('saldo ignorado, queda en 0', function () { pm.expect(data.bolsillo.saldo).to.eql(0); });",
                  "pm.environment.set('bolsilloMassId', data.bolsillo.id);"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "2.2 PATCH archivar bolsillo (saldo 0) -> 200",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"estado\": \"archivado\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/api/bolsillos/{{bolsilloMassId}}/estado", "host": ["{{baseUrl}}"], "path": ["api", "bolsillos", "{{bolsilloMassId}}", "estado"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', function () { pm.response.to.have.status(200); });"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "2.3 PATCH intentar reactivar bolsillo archivado -> 409",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"estado\": \"activo\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/api/bolsillos/{{bolsilloMassId}}/estado", "host": ["{{baseUrl}}"], "path": ["api", "bolsillos", "{{bolsilloMassId}}", "estado"] }
