PORT=3000
ALLOWED_ORIGIN=http://localhost:3000
## TRUST_PROXY=false (por defecto) | true (1 salto) | número de saltos de proxy confiables
## Configurar solo si la API corre detrás de un reverse proxy / balanceador real
TRUST_PROXY=false

# Claves requeridas para consumir los endpoints protegidos de /api
# Cada cliente tiene su propia API Key; no van en el código fuente.
API_KEY_POSTMAN=REEMPLAZAR_CON_API_KEY_SEGURA
API_KEY_ADMIN=REEMPLAZAR_CON_API_KEY_SEGURA
API_KEY_MOVIL=REEMPLAZAR_CON_API_KEY_SEGURA

## La persistencia en BaaS se agrega en una fase posterior