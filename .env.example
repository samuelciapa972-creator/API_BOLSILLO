PORT=3000
ALLOWED_ORIGIN=http://localhost:3000
## TRUST_PROXY=false (por defecto) | true (1 salto) | número de saltos de proxy confiables
## Configurar solo si la API corre detrás de un reverse proxy / balanceador real
TRUST_PROXY=false

# Claves requeridas para consumir los endpoints protegidos de /api
# Cada cliente tiene su propia API Key; no van en el código fuente.
API_KEY_POSTMAN=REEMPLAZAR_CON_API_KEY_SEGURA
API_KEY_ADMIN=REEMPLAZAR_CON_API_KEY_SEGURA
API_KEY_MOVIL=REEMPLAZAR_CON_API_KEY_SEGURA

# Secreto para firmar los JWT (generar con:
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))")
JWT_SECRET=REEMPLAZAR_CON_SECRETO_JWT_SEGURO
JWT_EXPIRES_IN=1h

# Conexión PostgreSQL (Supabase → Connect → Session pooler, puerto 5432).
# Valores ficticios: la URI real solo va en .env. Sin parámetros
# sslmode/sslrootcert: TLS se configura en src/config/database.js.
# Si la contraseña tiene caracteres especiales, codificarlos para URI.
DATABASE_URL=postgresql://USUARIO:CONTRASENA@HOST:5432/postgres

# Administrador inicial (bootstrap al arrancar).
# Solo un administrador puede crear otros administradores
# o auditores; este es el primero.
ADMIN_NOMBRE=Administrador Bolsillo
ADMIN_EMAIL=admin@bolsillo.com
ADMIN_PASSWORD=REEMPLAZAR_CON_PASSWORD_SEGURO
